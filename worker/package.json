{
  "name": "@zgame/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute zkraft --local --file=migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute zkraft --remote --file=migrations/0001_init.sql",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zgame/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "wrangler": "^4.143.0"
  }
}
