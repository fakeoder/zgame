{
  "name": "@zgame/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create zgame-db",
    "db:migrate:local": "wrangler d1 migrations apply zgame-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zgame-db --remote",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zgame/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "wrangler": "^4.143.0"
  }
}
